rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // to check if user is a regular user
    function isRegularUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Admin collection rules
    match /admins/{userId} {
      // Allow any user to read admin documents
      allow read: if isAuthenticated();
      // Only allow admins to write their own document
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Users collection rules - UPDATED
    match /users/{userId} {
      // Allow reading basic user profile data for feedback display
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered_opportunities', 'saved_opportunities']))
      );
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Causes collection rules
    match /causes/{causeId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (
        (isAdmin() && resource.data.createdBy == request.auth.uid) || 
        (isRegularUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered_users']))
      );
      allow delete: if isAdmin() && resource.data.createdBy == request.auth.uid;
    }
    
    // Notifications collection rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.data.hasOwnProperty('userId'));
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.data.hasOwnProperty('userId'));
      allow create: if isAuthenticated();
    }
    
    // Ratings collection rules - UPDATED
    match /ratings/{ratingId} {
      // Allow reading all ratings for a cause
      allow read: if isAuthenticated();
      
      // Allow creating ratings if user is authenticated and rating their own experience
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow updating own ratings or adding/removing likes
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );

      // Only admins can delete ratings
      allow delete: if isAdmin();
    }
    
    // Participant Removals collection rules
    match /participantRemovals/{removalId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || !resource.data.hasOwnProperty('userId'));
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}